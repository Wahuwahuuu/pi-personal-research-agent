{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pi-personal-research-agent",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [
      { "name": "AGENTS", "class_name": "PersonalAgent" },
      { "name": "IDENTITIES", "class_name": "IdentityRegistry" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PersonalAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["IdentityRegistry"] },
  ],
  "vars": {
    "MODEL_MODE": "mock",
    "OWNER_ID": "personal",
    "RESEARCH_ENGINE": "durable",
    "RESOURCE_WORKER_NAME": "pi-personal-research-agent",
  },
  "triggers": { "crons": ["*/30 * * * *"] },
  "observability": { "enabled": false },
}
