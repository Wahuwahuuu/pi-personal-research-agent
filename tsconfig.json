{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "node"],
    "lib": ["ES2023", "DOM"]
  },
  "include": [
    "src/**/*.ts",
    "local/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts"
  ]
}
