{
  "name": "pi-personal-research-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.1"
  },
  "scripts": {
    "check": "tsc --noEmit && tsc -p tsconfig.web.json",
    "test": "node --test tests/*.test.ts",
    "dev": "npm run web:build && wrangler dev",
    "build": "npm run web:build && wrangler deploy --dry-run --outdir dist/worker",
    "node": "node local/node.ts",
    "research:check": "npm run check --prefix packages/research",
    "research:test": "npm test --prefix packages/research",
    "web:build": "vite build",
    "web:dev": "vite",
    "test:web": "npm run web:build && node scripts/browser-check.ts"
  },
  "dependencies": {
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.1.0",
    "agents": "0.33.0",
    "fast-xml-parser": "5.12.0",
    "https-proxy-agent": "9.1.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261108.1",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "6.3.0",
    "miniflare": "5.20261104.0-beta",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "wrangler": "4.158.0"
  }
}
